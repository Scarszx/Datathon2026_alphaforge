# Copie ce fichier en `.env` puis renseigne les valeurs.
# `.env` est ignoré par git : ne commite jamais les vraies clés.

# Langfuse — traçage de développement (facultatif, fail-open).
# La clé publique (pk-lf-…) n'est pas secrète ; la clé secrète (sk-lf-…) ne doit
# jamais être committée. Sur AWS, elle passe par SSM (LANGFUSE_SECRET_PARAM).
LANGFUSE_PUBLIC_KEY="pk-lf-xxxxxxxx"
LANGFUSE_SECRET_KEY="sk-lf-xxxxxxxx"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
