# Exemple de valeurs : copier en terraform.tfvars (ignoré par git) et adapter.
# Les variables avec défaut (région, préfixe, modèles, CORS) n'ont pas besoin d'y figurer.

aws_region = "us-east-1"

# Version du jeu de données produite par l'ingestion (WS3) et téléversée
# dans s3://<bucket>/dataset/<version>/ — obligatoire pour terraform plan.
dataset_version = "2026-11-12"

# Couche AWS SDK for pandas (Python 3.12, arm64, région us-east-1).
# Trouver la dernière version : console AWS Lambda → Layers → onglet « AWS layers »,
# ou la table des couches de la doc AWS SDK for pandas. Format attendu :
#   arn:aws:lambda:us-east-1:336392948345:layer:AWSSDKPandas-Python312-Arm64:<version>
pandas_layer_arn = null

cors_origins = ["http://localhost:3000"]
log_level    = "INFO"
