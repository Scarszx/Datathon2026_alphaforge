# Mode réel (npm run dev) : à copier en .env. Valeurs données par `terraform output` (infra/terraform).
# URL de l'API Gateway, sans /v1 et sans barre finale (sortie api_url)
VITE_API_BASE_URL=https://<id>.execute-api.us-east-1.amazonaws.com
# Région et client d'application Cognito (sorties cognito_user_pool_client_id ; client sans secret, flux USER_PASSWORD_AUTH)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_CLIENT_ID=<client id>
